            "expected": {
                "response_status": "success",
                "must_convey": [
                    "The observed WBC values increased across the supplied measurements.",
                    "The latest stored WBC value is 12.0 with the canonical unit supplied by the runtime TrendResponse.",
                    "The latest stored WBC status is HIGH."
