                "selected_analyte": "WBC",
                "unit": "G/L",
                "points": [
                    {
                        "date": "2026-06-10",
                        "value": 6.5,
                        "status": "normal"
                    },
                    {
                        "date": "2026-07-12",
                        "value": 8.1,
                        "status": "normal"
                    },
                    {
                        "date": "2026-08-15",
                        "value": 12.0,
                        "status": "high"
                    }
