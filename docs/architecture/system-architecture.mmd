%% Diagram 0 — System Overview (high-level)
%% Xem chi tiết từng module tại các file .mmd khác trong docs/architecture/:
%%   frontend-module.mmd, backend-api-module.mmd, langgraph-pipeline.mmd,
%%   orchestrator-agent.mmd, data-deployment.mmd

graph LR

    CLIENT["Client Browser<br/>Patient / Doctor / Guest"]

    subgraph APP["Application"]
        FE["Frontend<br/>Next.js"]
        API["Backend API<br/>FastAPI"]
    end

    subgraph ENGINE["AI Engine"]
        MEDICAL["LangGraph Medical Pipeline<br/>(Reference Check → RAG/LLM → Guardrail)"]
        RETRIEVE["RAG Retriever<br/>(Embeddings + ChromaDB query)"]
        ORCH["Orchestrator<br/>Conversational Agent"]
    end

    subgraph DATA["Data & Knowledge"]
        DB[("SQLite / PostgreSQL<br/>Users · Reports · History")]
        CFG[("Reference Range &<br/>Critical Threshold Config")]
        %% Cạnh vô hình chỉ để canh layout (VDB nằm bên phải CFG) — KHÔNG phải
        %% quan hệ dữ liệu thật, SQLite/PostgreSQL và ChromaDB là 2 store độc lập.
        CFG ~~~ VDB
        VDB[("ChromaDB<br/>Medical Knowledge")]
    end

    subgraph CLOUD["External AI APIs"]
        LLM["OpenAI<br/>gpt-4o-mini / embeddings"]
        VISION["Google Gemini Vision<br/>OCR"]
    end

    CLIENT --> FE
    FE -->|"HTTPS REST / JWT"| API

    API --> MEDICAL
    API --> ORCH
    ORCH -.->|"chỉ gọi qua wrapper đã duyệt"| MEDICAL

    MEDICAL --> DB
    MEDICAL --> CFG
    ORCH --> DB

    MEDICAL --> RETRIEVE
    RETRIEVE --> VDB
    VDB --> RETRIEVE
    RETRIEVE --> LLM
    API -->|"OCR upload (trước khi vào Medical Pipeline)"| VISION

    API -->|"REST JSON"| FE
