# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# LLM chính của agent là Gemini (langchain-google-genai) — biến đúng tên
# đọc bởi src/config.py là GOOGLE_API_KEY, không phải GEMINI_KEY.
GOOGLE_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=

# ---- Auth (JWT) ----
# Đổi giá trị thật khi deploy — KHÔNG dùng default dev khi production.
JWT_SECRET=dev-only-insecure-secret-change-me

# ---- Database ----
# SQLite là default cho dev + demo V2 (bảng users tối thiểu, tự seed lúc
# khởi động). Trên Railway (không gắn Volume), disk là ephemeral — mỗi lần
# restart/redeploy DB reset về seed mặc định, đây là hành vi CHỦ Ý cho quy
# mô demo hiện tại.
DATABASE_URL=sqlite:///./data/app.db
# Nếu cần Postgres thật (persistent), đổi sang:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Production: liệt kê đúng domain Vercel thật, cách nhau bằng dấu phẩy
# (vd. https://vmec-05.vercel.app), KHÔNG để localhost trên production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Agent Rules / Reference ----
CRITICAL_THRESHOLDS_PATH=./data/reference/critical_thresholds.json

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (dùng trong frontend/.env.local, không phải .env gốc) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: trỏ về đúng URL backend Railway, vd:
# NEXT_PUBLIC_API_URL=https://vmec-05-api.up.railway.app
