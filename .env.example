# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# LLM chính của agent là Gemini (langchain-google-genai) — biến đúng tên
# đọc bởi src/config.py là GOOGLE_API_KEY, không phải GEMINI_KEY.
GOOGLE_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-key-here
# Maximum total wait for one explanation before using the curated fallback.
LLM_TIMEOUT_SECONDS=20
MODEL_NAME=gpt-4o-mini
# Or use other providers:
# ANTHROPIC_API_KEY=

# ---- Auth (JWT) ----
# Đổi giá trị thật khi deploy — KHÔNG dùng default dev khi production.
JWT_SECRET=dev-only-insecure-secret-change-me
# Thời gian sống của phiên khách (guest). Ngắn hơn phiên đăng nhập vì khách
# không có gì để khôi phục sau khi hết hạn.
GUEST_SESSION_EXPIRE_MINUTES=120

# ---- Database ----
# SQLite là default cho dev + demo (users + lab_reports + lab_report_indicators,
# tự tạo bảng và seed tài khoản demo lúc khởi động).
# CẢNH BÁO V3: từ khi có đăng ký tài khoản thật và lịch sử bệnh nhân, disk
# ephemeral của Railway (chưa gắn Volume) đồng nghĩa với việc MẤT tài khoản
# người dùng đăng ký + toàn bộ lịch sử sau mỗi lần redeploy. Chấp nhận được
# cho demo; phải đổi sang Postgres trước khi có người dùng thật.
DATABASE_URL=sqlite:///./data/app.db
# Nếu cần Postgres thật (persistent), đổi sang:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# RAG is optional enrichment. Structured analyte/range lookup never uses embeddings.
# Keep disabled until the external provider key and a versioned collection are ready.
RAG_ENABLED=false
RAG_COLLECTION_NAME=medical_kb_v1
RAG_CORPUS_VERSION=medical-kb-v1
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=20

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Giá trị dưới đây dành cho máy dev. Trên production phải là ĐÚNG domain thật,
# không kèm localhost — hiện Railway đang set:
#   CORS_ORIGINS=https://vmec-05.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Agent Rules / Reference ----
CRITICAL_THRESHOLDS_PATH=./data/reference/critical_thresholds.json

# ---- Vision LLM (OCR — ADR-006) ----
# Primary OCR gọi Gemini trực tiếp bằng GOOGLE_API_KEY ở trên.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_TIMEOUT_SECONDS=15
GEMINI_VISION_MAX_OUTPUT_TOKENS=2048
GEMINI_VISION_THINKING_LEVEL=low
# OpenRouter chỉ là fallback cho lỗi Gemini tạm thời.
# OpenRouter: https://openrouter.ai -> account -> keys
OPENROUTER_API_KEY=your-openrouter-key-here
# Fallback VLM model. Default = free vision-extraction model.
# NOTE: OpenRouter free-tier catalog changes frequently — check the live list
# at https://openrouter.ai/models before relying on a specific `:free` ID.
VISION_MODEL=google/gemma-4-26b-a4b-it:free
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_TIMEOUT_SECONDS=30
# VISION_MAX_IMAGE_MB=10
# Chỉ số dưới ngưỡng này phải được xác nhận riêng tại OCR Review Gate.
OCR_LOW_CONFIDENCE_THRESHOLD=0.7
# Bản nháp OCR chỉ tồn tại phía client; token xác nhận ngắn hạn hết hạn sau 15 phút.
OCR_REVIEW_TOKEN_EXPIRE_MINUTES=15
# Chính sách nhận ảnh cho bản demo công khai (V3) — đổi được mà không sửa code:
#   internal_only     tắt hẳn /ocr/upload (503)
#   demo_only         CHỈ nhận đúng ảnh trong data/ocr_samples (đối chiếu SHA-256)
#   open_with_consent nhận ảnh bất kỳ, vẫn bắt buộc tick consent
# Mặc định demo_only — an toàn nhất khi link công khai cho người ngoài dùng thử.
OCR_UPLOAD_MODE=demo_only
OCR_SAMPLES_DIR=./data/ocr_samples

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (dùng trong frontend/.env.local, không phải .env gốc) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: trỏ về đúng URL backend Railway, vd:
# NEXT_PUBLIC_API_URL=https://vmec-05-api-production.up.railway.app
