# VMEC-05 environment template
# Copy to .env for the backend. Never commit real credentials.

# -----------------------------------------------------------------------------
# Application — safe defaults for local development
# -----------------------------------------------------------------------------
APP_NAME=LumiLab
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
# Production example: postgresql://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# LLM providers — configure the key for the selected provider
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# OCR / vision — Gemini primary, OpenRouter optional fallback
# -----------------------------------------------------------------------------
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_TIMEOUT_SECONDS=15
GEMINI_VISION_MAX_OUTPUT_TOKENS=2048
GEMINI_VISION_THINKING_LEVEL=low
OPENROUTER_API_KEY=
VISION_MODEL=google/gemma-4-26b-a4b-it:free
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_TEMPERATURE=0.0
VISION_MAX_IMAGE_MB=10
VISION_TIMEOUT_SECONDS=30
OCR_LOW_CONFIDENCE_THRESHOLD=0.7
OCR_REVIEW_TOKEN_EXPIRE_MINUTES=15
# internal_only | demo_only | open_with_consent
OCR_UPLOAD_MODE=demo_only
OCR_SAMPLES_DIR=./data/ocr_samples

# -----------------------------------------------------------------------------
# Medical RAG — optional; deterministic reference classification never uses it
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
RAG_ENABLED=false
RAG_COLLECTION_NAME=medical_kb_v4
RAG_CORPUS_VERSION=medical-kb-v4
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=20
RETRIEVAL_MIN_SCORE=0.40
RETRIEVAL_TOP_K=3
METADATA_PRONG_ENABLED=true
METADATA_MIN_CHUNK_LENGTH=30
MAX_ANALYZER_CONTEXT_CHARS=4000
MAX_GUARDRAIL_CONTEXT_CHARS=3000

# App-help RAG uses a separate collection and corpus.
APP_HELP_RAG_ENABLED=false
APP_HELP_COLLECTION_NAME=app_help_kb_v1
APP_HELP_CORPUS_VERSION=app-help-kb-v1
APP_HELP_CORPUS_DIR=./data/app_how_to_use
APP_HELP_RETRIEVAL_MIN_SCORE=0.70
APP_HELP_RETRIEVAL_TOP_K=3

# -----------------------------------------------------------------------------
# Governed reference paths — normally leave unchanged
# -----------------------------------------------------------------------------
CRITICAL_THRESHOLDS_PATH=./data/reference/critical_thresholds.json
INPUT_INTEGRITY_RULES_PATH=./data/reference/input_integrity_rules.json

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Required in production. The development value is deliberately insecure.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
GUEST_SESSION_EXPIRE_MINUTES=120
# Public OAuth client ID; empty disables Google Sign-In.
GOOGLE_OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# Tracing / observability — optional and fail-open
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_MASK_PAYLOADS=true
TRACE_PERSISTENCE_ENABLED=true
TRACE_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Frontend — place this in frontend/.env.local, not the backend .env
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Development/evaluation logging helpers — never place real keys in this file
# -----------------------------------------------------------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
# Optional integrations used only by repository logging helpers:
# ANTIGRAVITY_BRAIN_DIR=
# AI_TOOL_NAME=
